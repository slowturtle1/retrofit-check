# Copy to .env and fill in. Never commit .env.

# Data: Zetaris (local install). Create the API key yourself in the Zetaris UI.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Power: Meterless Nightshift. URL and token come from Nightshift > Console (top right).
# The model is pinned to NVIDIA Nemotron; every reply carries a receipt naming the model that answered.
# The NVIDIA key goes in Nightshift > Setup > Providers, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_APP=open-agent-hack

# smoke_test.py reads these three. On the Meterless route they mirror the values above,
# so the token is pasted once (python-dotenv fills in ${...}).
MODEL_BASE_URL=${METERLESS_BASE_URL}
MODEL_API_KEY=${METERLESS_RUNTIME_TOKEN}
NEMOTRON_MODEL=${METERLESS_MODEL}

# Display only: Google Photorealistic 3D Tiles (Map Tiles API). Create the key yourself,
# restricted to Map Tiles API and http://localhost:5173/*, then run tools/set_google_maps_key.py.
GOOGLE_MAPS_API_KEY=
# The same for GitHub Pages: a second key restricted to Map Tiles API and https://slowturtle1.github.io/*,
# saved with tools/set_google_maps_key.py pages, then: gh secret set PAGES_GOOGLE_MAPS_API_KEY.
# .github/workflows/pages.yml adds it to the page when it deploys; it is never in git.
PAGES_GOOGLE_MAPS_API_KEY=

# Cache database (Postgres in Docker on the Zetaris network). Any long random string.
RETROFIT_DB_PASSWORD=

# H-MEM memory service (hmem/server.ts). Default shown.
HMEM_URL=http://127.0.0.1:8790

# true = no Zetaris, Nightshift, H-MEM or keys: the agent runs on the snapshot in samples/cache.sqlite,
# and fetches any other house in England straight from the public sources (set DIRECT_SOURCES=false to stop that).
SAMPLE_MODE=false
DIRECT_SOURCES=true

# Time limits in seconds for each sponsor call (every call also has a fallback path).
ZETARIS_TIMEOUT=90
MODEL_TIMEOUT=120
# Seconds from the start of a check after which no Nemotron call starts or waits; the card shows before that
MODEL_BUDGET=150
# Seconds the first, trivial Zetaris query may take before the check reads the local snapshot instead
ZETARIS_PROBE_TIMEOUT=8
PLANNING_TIMEOUT=60
